        "\n",
        "# ============================================================\n",
        "# VISIONPORT EXPERIMENT 2\n",
        "# END-TO-END DEEP LEARNING SYSTEM ARCHITECTURE\n",
        "# FastAPI + Triton + TensorRT + YOLO + GPU\n",
        "# ============================================================\n",
        "\n",
        "# 1. INSTALL DEPENDENCIES\n",
        "!pip install -q ultralytics fastapi uvicorn python-multipart requests\n",
        "\n",
        "# 2. IMPORT LIBRARIES\n",
        "import os\n",
        "import time\n",
        "import threading\n",
        "import requests\n",
        "import cv2\n",
        "import torch\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.patches as patches\n",
        "\n",
        "from ultralytics import YOLO\n",
        "from fastapi import FastAPI, UploadFile, File\n",
        "from fastapi.responses import JSONResponse\n",
        "from google.colab import files\n",
        "from io import BytesIO\n",
        "from PIL import Image\n",
        "import uvicorn\n",
        "\n",
        "print(\"=\" * 65)\n",
        "print(\"       VISIONPORT - END-TO-END SYSTEM ARCHITECTURE\")\n",
        "print(\"=\" * 65)\n",
        "\n",
        "# 3. CHECK HARDWARE AND SOFTWARE\n",
        "gpu_available = torch.cuda.is_available()\n",
        "\n",
        "if gpu_available:\n",
        "    gpu_name = torch.cuda.get_device_name(0)\n",
        "    hardware = gpu_name\n",
        "else:\n",
        "    gpu_name = \"No NVIDIA GPU detected\"\n",
        "    hardware = \"CPU\"\n",
        "\n",
        "print(\"\\nSYSTEM CONFIGURATION\")\n",
        "print(\"-\" * 45)\n",
        "print(\"PyTorch Version:\", torch.__version__)\n",
        "print(\"GPU Available:\", gpu_available)\n",
        "print(\"Hardware:\", hardware)\n",
        "\n",
        "# Check TensorRT\n",
        "try:\n",
        "    import tensorrt as trt\n",
        "    tensorrt_available = True\n",
        "    trt_version = trt.__version__\n",
        "except Exception:\n",
        "    tensorrt_available = False\n",
        "    trt_version = \"Not installed\"\n",
        "\n",
        "# Check Triton client availability\n",
        "try:\n",
        "    import tritonclient\n",
        "    triton_client_available = True\n",
        "except Exception:\n",
        "    triton_client_available = False\n",
        "\n",
        "# Check Triton server health endpoint\n",
        "try:\n",
        "    triton_response = requests.get(\n",
        "        \"http://localhost:8000/v2/health/ready\",\n",
        "        timeout=2\n",
        "    )\n",
        "    triton_running = triton_response.status_code == 200\n",
        "except Exception:\n",
        "    triton_running = False\n",
        "\n",
        "print(\"TensorRT:\", trt_version)\n",
        "print(\"Triton Client Installed:\", triton_client_available)\n",
        "print(\"Triton Server Running:\", triton_running)\n",
        "\n",
        "# 4. UPLOAD IMAGE\n",
        "print(\"\\nUPLOAD YOUR INPUT IMAGE\")\n",
        "uploaded = files.upload()\n",
        "\n",
        "image_path = list(uploaded.keys())[0]\n",
        "\n",
        "# 5. LOAD YOLO MODEL\n",
        "print(\"\\nLoading YOLOv8 Model...\")\n",
        "model = YOLO(\"yolov8n.pt\")\n",
        "\n",
        "print(\"YOLOv8 Model Loaded Successfully!\")\n",
        "\n",
        "# 6. CREATE FASTAPI APPLICATION\n",
        "app = FastAPI(\n",
        "    title=\"VisionPort Inference API\",\n",
        "    description=\"End-to-End Deep Learning Image Detection API\",\n",
        "    version=\"1.0\"\n",
        ")\n",
        "\n",
        "@app.get(\"/\")\n",
        "def home():\n",
        "    return {\n",
        "        \"project\": \"VisionPort\",\n",
        "        \"status\": \"Running\",\n",
        "        \"model\": \"YOLOv8 Nano\"\n",
        "    }\n",
        "\n",
        "@app.get(\"/health\")\n",
        "def health():\n",
        "    return {\n",
        "        \"api_status\": \"Healthy\",\n",
        "        \"model_loaded\": True,\n",
        "        \"hardware\": hardware\n",
        "    }\n",
        "\n",
        "@app.post(\"/predict\")\n",
        "async def predict(file: UploadFile = File(...)):\n",
        "\n",
        "    start_time = time.time()\n",
        "\n",
        "    # Read image received through API\n",
        "    content = await file.read()\n",
        "    pil_image = Image.open(BytesIO(content)).convert(\"RGB\")\n",
        "    input_array = np.array(pil_image)\n",
        "\n",
        "    # Run deep learning inference\n",
        "    results = model.predict(\n",
        "        source=input_array,\n",
        "        conf=0.25,\n",
        "        imgsz=640,\n",
        "        verbose=False\n",
        "    )\n",
        "\n",
        "    inference_time = time.time() - start_time\n",
        "\n",
        "    # Extract detected objects\n",
        "    detections = []\n",
        "\n",
        "    for box in results[0].boxes:\n",
        "        class_id = int(box.cls[0])\n",
        "        confidence = float(box.conf[0])\n",
        "\n",
        "        detections.append({\n",
        "            \"object\": model.names[class_id],\n",
        "            \"confidence\": round(confidence * 100, 2),\n",
        "            \"box\": [round(float(x), 2) for x in box.xyxy[0]]\n",
        "        })\n",
        "\n",
        "    return {\n",
        "        \"status\": \"success\",\n",
        "        \"filename\": file.filename,\n",
        "        \"total_objects\": len(detections),\n",
        "        \"inference_time_ms\": round(inference_time * 1000, 2),\n",
        "        \"detections\": detections\n",
        "    }\n",
        "\n",
        "# 7. START FASTAPI SERVER\n",
        "def start_server():\n",
        "    uvicorn.run(\n",
        "        app,\n",
        "        host=\"127.0.0.1\",\n",
        "        port=8000,\n",
        "        log_level=\"error\"\n",
        "    )\n",
        "\n",
        "server_thread = threading.Thread(\n",
        "    target=start_server,\n",
        "    daemon=True\n",
        ")\n",
        "server_thread.start()\n",
        "\n",
        "# Wait for API server\n",
        "api_ready = False\n",
        "\n",
        "for i in range(30):\n",
        "    try:\n",
        "        response = requests.get(\n",
        "            \"http://127.0.0.1:8000/health\",\n",
        "            timeout=2\n",
        "        )\n",
        "        if response.status_code == 200:\n",
        "            api_ready = True\n",
        "            break\n",
        "    except Exception:\n",
        "        time.sleep(1)\n",
        "\n",
        "if not api_ready:\n",
        "    raise RuntimeError(\"FastAPI server failed to start!\")\n",
        "\n",
        "print(\"\\nFASTAPI SERVER STARTED SUCCESSFULLY!\")\n",
        "print(\"API Address: http://127.0.0.1:8000\")\n",
        "print(\"Health Endpoint: /health\")\n",
        "print(\"Prediction Endpoint: /predict\")\n",
        "\n",
        "# 8. SEND IMAGE THROUGH FASTAPI\n",
        "print(\"\\nSending Image Through HTTP POST Request...\")\n",
        "\n",
        "with open(image_path, \"rb\") as f:\n",
        "    api_start = time.time()\n",
        "\n",
        "    api_response = requests.post(\n",
        "        \"http://127.0.0.1:8000/predict\",\n",
        "        files={\n",
        "            \"file\": (\n",
        "                os.path.basename(image_path),\n",
        "                f,\n",
        "                \"image/jpeg\"\n",
        "            )\n",
        "        },\n",
        "        timeout=180\n",
        "    )\n",
        "\n",
        "    api_elapsed = time.time() - api_start\n",
        "\n",
        "if api_response.status_code != 200:\n",
        "    raise RuntimeError(api_response.text)\n",
        "\n",
        "output_data = api_response.json()\n",
        "\n",
        "print(\"\\nAPI RESPONSE RECEIVED!\")\n",
        "print(\"Status:\", output_data[\"status\"])\n",
        "print(\"Total Objects:\", output_data[\"total_objects\"])\n",
        "print(\"Inference Time:\", output_data[\"inference_time_ms\"], \"ms\")\n",
        "\n",
        "# 9. GET DETECTION IMAGE\n",
        "original = cv2.imread(image_path)\n",
        "original_rgb = cv2.cvtColor(original, cv2.COLOR_BGR2RGB)\n",
        "\n",
        "results = model.predict(\n",
        "    source=original_rgb,\n",
        "    conf=0.25,\n",
        "    imgsz=640,\n",
        "    verbose=False\n",
        ")\n",
        "\n",
        "detected_image = results[0].plot()\n",
        "detected_image = cv2.cvtColor(\n",
        "    detected_image,\n",
        "    cv2.COLOR_BGR2RGB\n",
        ")\n",
        "\n",
        "# 10. GRAPHICAL OUTPUT - IMAGE DETECTION\n",
        "plt.figure(figsize=(16, 7))\n",
        "\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.imshow(original_rgb)\n",
        "plt.title(\"Client Input Image\", fontsize=14)\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.subplot(1, 2, 2)\n",
        "plt.imshow(detected_image)\n",
        "plt.title(\"VisionPort API - Detected Objects\", fontsize=14)\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 11. GRAPHICAL OUTPUT - ARCHITECTURE\n",
        "fig, ax = plt.subplots(figsize=(12, 9))\n",
        "ax.set_xlim(0, 10)\n",
        "ax.set_ylim(0, 12)\n",
        "ax.axis(\"off\")\n",
        "\n",
        "architecture = [\n",
        "    (\"CLIENT / GOOGLE COLAB\", \"Upload Image\"),\n",
        "    (\"FASTAPI REST API\", \"HTTP POST /predict\"),\n",
        "    (\"TRITON INFERENCE SERVER\",\n",
        "     \"Model Serving Layer - conceptual in this demo\"),\n",
        "    (\"TENSORRT OPTIMIZATION\",\n",
        "     \"GPU Engine - not executed in this demo\"),\n",
        "    (\"YOLOv8 DEEP LEARNING MODEL\", \"Object Detection\"),\n",
        "    (\"GPU / CPU EXECUTION\", hardware),\n",
        "    (\"JSON RESPONSE\", \"Objects + Confidence + Coordinates\")\n",
        "]\n",
        "\n",
        "colors = [\n",
        "    \"#DCEBFF\", \"#D9F5EE\", \"#FCE8D5\",\n",
        "    \"#EADCF8\", \"#DCEBFF\", \"#D9F5EE\", \"#DDF4DC\"\n",
        "]\n",
        "\n",
        "for i, (title, subtitle) in enumerate(architecture):\n",
        "    y = 10.7 - i * 1.5\n",
        "\n",
        "    rect = patches.FancyBboxPatch(\n",
        "        (1.5, y), 7, 0.95,\n",
        "        boxstyle=\"round,pad=0.08\",\n",
        "        facecolor=colors[i],\n",
        "        edgecolor=\"#334155\",\n",
        "        linewidth=1.5\n",
        "    )\n",
        "\n",
        "    ax.add_patch(rect)\n",
        "\n",
        "    ax.text(\n",
        "        5, y + 0.62, title,\n",
        "        ha=\"center\", va=\"center\",\n",
        "        fontsize=11, fontweight=\"bold\"\n",
        "    )\n",
        "\n",
        "    ax.text(\n",
        "        5, y + 0.27, subtitle,\n",
        "        ha=\"center\", va=\"center\",\n",
